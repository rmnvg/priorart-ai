SERPAPI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision model for sketch/photo input
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional: comma-separated origins of a deployed frontend
ALLOWED_ORIGINS=

# Search budget per analysis: "full" (up to 16 searches) or "lean" (up to 11)
SEARCH_PROFILE=full
# Every SerpApi response is saved in backend/.serpapi-cache/ and replayed for
# an identical request, so each search is paid for once
SERPAPI_CACHE=true
# true = never call SerpApi; uncached requests fail instead of spending quota
SERPAPI_OFFLINE=false
